# Copy to .env and fill in. NEVER commit .env.
# Paper trading keys from https://app.alpaca.markets (paper dashboard).
MERCURIUS_ALPACA_API_KEY=your-paper-key-id
MERCURIUS_ALPACA_SECRET_KEY=your-paper-secret
# true = paper endpoints. Do not flip to false until the go/no-go gate passes.
MERCURIUS_ALPACA_PAPER=true

# Optional Telegram notifications (leave empty to disable).
MERCURIUS_TELEGRAM_BOT_TOKEN=
MERCURIUS_TELEGRAM_CHAT_ID=
