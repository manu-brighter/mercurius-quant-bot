# secrets
.env

# runtime data (never committed): bar cache, journal, logs, chain snapshots, holdout
# NOTE: leading slash is load-bearing. An unanchored `data/` also matches
# src/mercurius/data/ and silently drops the whole data layer from commits.
/data/

# python
__pycache__/
*.pyc
*.egg-info/
.venv/
.pytest_cache/
.ruff_cache/
dist/
build/

# notebooks: keep sources, drop checkpoints
notebooks/.ipynb_checkpoints/
